/*---
desc: >-
      A class implementing an interface with optional properties must declare them explicitly.
      An explicitly declared optional property reads as undefined before initialization and stores written values.
---*/

interface I {
  n?: number
}

class C implements I {
  n?: number
}

function main() {
  let c = new C()
  arktest.assertEQ(c.n, undefined)
  c.n = 1
  arktest.assertEQ(c.n, 1)
}
