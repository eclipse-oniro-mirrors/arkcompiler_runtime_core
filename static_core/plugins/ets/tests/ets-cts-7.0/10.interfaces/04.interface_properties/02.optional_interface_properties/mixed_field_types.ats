/*---
desc: >-
    Every optional interface property must be explicitly declared by the implementing class, together with
    mandatory interface fields and own fields. A declared optional property reads as undefined before
    initialization and stores written values.
---*/

interface I {
  a?: number
  b?: number
  c: number
}

class C implements I {
  a: number | undefined = 2
  b?: number
  c: number = 1
  d: number = 3
  e?: number = undefined
}

function main() {
  let i: C = new C()
  arktest.assertEQ(i.a, 2)
  arktest.assertEQ(i.b, undefined)
  arktest.assertEQ(i.c, 1)
  arktest.assertEQ(i.d, 3)
  arktest.assertEQ(i.e, undefined)
  i.b = 5
  arktest.assertEQ(i.b, 5)
}
