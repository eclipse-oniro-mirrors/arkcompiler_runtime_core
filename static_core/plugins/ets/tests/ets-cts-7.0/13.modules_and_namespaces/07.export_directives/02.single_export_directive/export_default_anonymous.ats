/*---
desc:  The directive in the example below exports constant variable of some type anonymously.
files: ['./export_default_anonymous/export_string.ats', 
'./export_default_anonymous/export_number.ats',
'./export_default_anonymous/export_newclass.ats',
'./export_default_anonymous/export_multi_expressions.ats',
'./export_default_anonymous/export_lambda.ats',
'./export_default_anonymous/export_array.ats',
'./export_default_anonymous/export_add_expressions.ats']
expected_error:
    compiler:
        - "Warning: default element has already imported"
---*/

import { default as export_string } from "./export_default_anonymous/export_string.ats";
import { default as export_number } from "./export_default_anonymous/export_number.ats";
import { default as export_newclass } from "./export_default_anonymous/export_newclass.ats";
import { default as export_multi_expressions } from "./export_default_anonymous/export_multi_expressions.ats";
import { default as export_lambda } from "./export_default_anonymous/export_lambda.ats";
import { default as export_array } from "./export_default_anonymous/export_array.ats";
import { default as export_add_expressions } from "./export_default_anonymous/export_add_expressions.ats";

function main() {
    arktest.assertEQ(export_string, "export_string")

    arktest.assertEQ(export_number, 123456)

    arktest.assertEQ(export_newclass.foo(), "export_newclass_A_foo is invoked")
    arktest.assertEQ(export_newclass.field, "export_newclass_A_field")

    arktest.assertEQ(export_multi_expressions, 110)

    arktest.assertEQ(export_lambda(), "export_lambda is invoked")

    arktest.assertEQ(export_array[0], 1)

    arktest.assertEQ(export_add_expressions, 21)
}
