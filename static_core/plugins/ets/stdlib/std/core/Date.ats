    /**
     * Sets the month for a specified date according to the currently set year.
     *
     * @param { int } month new month
     * @returns { long } get new date value
     * @syscap SystemCapability.Utils.Lang
     * @FaAndStageModel
     */
    public setMonth(month: int): long {
        let tzOffset = this.TZOffset;
        let localTime = this.ms - tzOffset * 60 * msPerSecond;
        let yearsNow: int = ecmaYearFromTime(localTime);
        let yearsOffSet: int = Math.floor(month / 12.0).toInt();
        let yearsNew = yearsNow + yearsOffSet;
        let adjustMonth = ((month % 12) + 12) % 12;
        if (yearsNew !== yearsNow) {
            this.setFullYear(yearsNew);
            tzOffset = this.TZOffset;
            localTime = this.ms - tzOffset * 60 * msPerSecond;
        }
        let year = ecmaYearFromTime(localTime);
        let inLeapYear = ecmaInLeapYear(year);
        let daysNow: int = getFirstDayInMonth(inLeapYear, ecmaMonthFromTime(localTime));
        let daysNew: int = getFirstDayInMonth(inLeapYear, adjustMonth);
        let dayOfMonth = ecmaDateFromTime(localTime);
        this.ms -= (daysNow + dayOfMonth - 1) * msPerDay;
        this.ms += (daysNew + dayOfMonth - 1) * msPerDay;
        return this.ms;
    }

    /**
     * Sets the month for a specified date according to the currently set year.
     *
     * @param { int } month new month
     * @param { int } date
     * @returns { long } get new date value
     * @syscap SystemCapability.Utils.Lang
     * @FaAndStageModel
     */
    public setMonth(month: int, date: int): long {
        this.setMonth(month);
        this.setDate(date);
        return this.ms;
    }

    /**
     * Sets the month for a specified date according to universal time.
     *
     * @param { int } month new month
     * @returns { long } get new date value
     * @syscap SystemCapability.Utils.Lang
     * @FaAndStageModel
     */
    public setUTCMonth(month: int): long {
        let yearsNow: int = this.getUTCFullYear();
        let yearsOffSet: int = Math.floor(month / 12.0).toInt();
        let yearsNew: int = yearsNow + yearsOffSet;
        let adjustedMonth: int = ((month % 12) + 12) % 12;
        if (yearsNew !== yearsNow) {
            this.setUTCFullYear(yearsNew);
        }
        let inLeapYear = ecmaInLeapYear(this.getUTCFullYear());
        let daysNow: int = getFirstDayInMonth(inLeapYear, this.getUTCMonth());
        let daysNew: int = getFirstDayInMonth(inLeapYear, adjustedMonth);

        let dayOfMonth = this.getUTCDate();
        this.ms -= (daysNow + dayOfMonth - 1) * msPerDay;
        this.ms += (daysNew + dayOfMonth - 1) * msPerDay;
        return this.ms;
    }

    /**
     * Sets the month for a specified date according to universal time.
     *
     * @param { int } month new month
     * @param { int } date
     * @returns { long } get new date value
     * @syscap SystemCapability.Utils.Lang
     * @FaAndStageModel
     */
    public setUTCMonth(month: int, date: int): long {
        this.setUTCMonth(month);
        this.setUTCDate(date);
        return this.ms;
    }

    /**
     * Returns the number of milliseconds since the epoch,
     * which is defined as the midnight at the beginning of January 1, 1970, UTC.
     *
     * @returns { long } get new date value
     * @syscap SystemCapability.Utils.Lang
     * @FaAndStageModel
     */
    public getTime(): long {
        return this.ms;
    }

    /**
     * Sets the number of milliseconds since the epoch,
     * which is defined as the midnight at the beginning of January 1, 1970, UTC.
     *
     * @param { long } value new ms
     * @returns { long } get new date value
     * @syscap SystemCapability.Utils.Lang
     * @FaAndStageModel
     */
    public setTime(value: long): long {
        this.ms = value;
        return this.ms;
    }

    /**
     * Parses a string representation of a date,
     * and returns the number of milliseconds since January 1, 1970, 00:00:00 UTC
     * or throws `RangeError` if the string is unrecognized or, in some cases,
     * contains illegal date values (e.g. 2015-02-31).
     *
     * Only the @link{https://tc39.es/ecma262/#sec-date-time-string-format|ISO 8601 format}
     * (YYYY-MM-DDTHH:mm:ss.sssZ) is explicitly specified to be supported.
     * Other formats are implementation-defined and may not work across all browsers (targets).
     * A library can help if many different formats are to be accommodated.
     *
     * @param { string } dateStr to be parsed
     * @returns { long } get new date value
     * @throws { RangeError } if the argument doesn't represent a valid date.
     * @static
     * @syscap SystemCapability.Utils.Lang
     * @FaAndStageModel
     */
    public static parse(dateStr: string): long {
        return Date.parseDateFromString(dateStr);
    }

    /**
     * Returns the difference, in minutes, between a date as
     * evaluated in the UTC time zone, and the same date as evaluated in the local time zone.
     *
     * @returns { long } get new date value
     * @syscap SystemCapability.Utils.Lang
     * @FaAndStageModel
     */
    public getTimezoneOffset(): long {
        return this.TZOffset;
    }

    /**
     * Sets the difference, in minutes, between a date as
     * evaluated in the UTC time zone, and the same date as evaluated in the local time zone.
     *
     * @param { int } value new timezone offset
     * @returns { long } get new date value
     * @syscap SystemCapability.Utils.Lang
     * @FaAndStageModel
     */
    public setTimezoneOffset(value: int): long {
        const diff = value - this.getTimezoneOffset();
        this.ms += diff * msPerMinute;
        return this.getTimezoneOffset();
    }

    /**
     * Returns a string in simplified extended ISO format (ISO 8601),
     * which is always 24 or 27 characters long (YYYY-MM-DDTHH:mm:ss.sssZ or
     * ±YYYYYY-MM-DDTHH:mm:ss.sssZ, respectively). The timezone is always zero UTC offset,
     * as denoted by the suffix Z.
     *
     * @returns { string } get new date value
     * @syscap SystemCapability.Utils.Lang
     * @FaAndStageModel
     */
    public toISOString(): string {
        if (!this.isDateValid()) {
            throw new RangeError('Invalid time value')
        }
        let sb = new StringBuilder();
        let y = this.getUTCFullYear();
        let yearLength: int = 4;
        if (y > 9999) {
            sb.append('+');
            yearLength = 6;
        } else if (y < 0) {
            sb.append('-');
            yearLength = 6;
        }
        sb.append(abs(y).toString().padStart(yearLength, c'0'));
        sb.append("-");
        let month = this.getUTCMonth() + 1;
        if (month < 10) {
            sb.append("0");
        }
        sb.append(month);
        sb.append("-");
        let day = this.getUTCDate();
        if (day < 10) {
            sb.append("0");
        }
        sb.append(day);
        sb.append("T");
        let h = this.getUTCHours();
        if (h < 10) {
            sb.append("0");
        }
        sb.append(h);
        sb.append(":");
        let m = this.getUTCMinutes();
        if (m < 10) {
            sb.append("0");
        }
        sb.append(m);
        sb.append(":");
        let s = this.getUTCSeconds();
        if (s < 10) {
            sb.append("0");
        }
        sb.append(s);
        sb.append(".");
        let ms = this.getUTCMilliseconds();
        if (ms < 10) {
            sb.append("00")
        }
        else if (ms < 100) {
            sb.append("0")
        }
        // sb.append(ms / 100);
        // sb.append((ms / 10) % 10);
        // sb.append(ms % 10);
        sb.append(ms)
        sb.append("Z");
        return sb.toString();
    }

    /**
     * Returns a string representation of the Date object.
     *
     * @returns { string | null } get new date value
     * @syscap SystemCapability.Utils.Lang
     * @FaAndStageModel
     */
    public toJSON(): string | null {
        if (!this.isDateValid()) {
            return null;
        }
        return this.toISOString();
    }

    /**
     * Returns the time portion of a `Date` object interpreted in the local timezone in English.
     *
     * @returns { string } get new date value
     * @syscap SystemCapability.Utils.Lang
     * @FaAndStageModel
     */
    public toTimeString(): string {
        if (!this.isDateValid()) {
            throw new Error('Invalid Date');
        }
        let tzOffset = this.TZOffset;	 
        return Date.formatTimeString(this.ms, tzOffset);
    }

    /**
     * Returns string representation
     */
    private timeString(localTime: long): String {
        let sb = new StringBuilder();
        let h = ecmaHourFromTime(localTime);
        if (h < 10) {
            sb.append("0");
        }
        sb.append(h);
        sb.append(":");
        let m = ecmaMinFromTime(localTime);
        if (m < 10) {
            sb.append("0");
        }
        sb.append(m);
        sb.append(":");
        let s = ecmaSecFromTime(localTime);
        if (s < 10) {
            sb.append("0");
        }
        sb.append(s);
        return sb.toString();
    }

    /**
     * Returns the date portion of a `Date` object interpreted in the local timezone in English.
     *
     * @returns { string } get new date value
     * @throws { Error } - Input parameter error.
     * @syscap SystemCapability.Utils.Lang
     * @FaAndStageModel
     */
    public toDateString(): string {
        if (!this.isDateValid()) {
            throw new Error('Invalid Date');
        }
        let localTime = this.ms - this.TZOffset * 60 * msPerSecond;
        return this.dateString(localTime);
    }

    /**
     * Returns a string representation
     */
    private dateString(localTime: long): String {
        let sb = new StringBuilder();
        sb.append(dayNames[ecmaWeekDay(localTime)]);
        sb.append(" ");
        sb.append(monthNames[ecmaMonthFromTime(localTime)]);
        sb.append(" ");
        let d = ecmaDateFromTime(localTime);
        if (d < 10) {
            sb.append("0");
        }
        sb.append(d);
        sb.append(" ");
        let y = ecmaYearFromTime(localTime);
        if (y < 0) {
            sb.append("-");
        }
        if (abs(y) < 1000) {
            sb.append("0");
        }
        if (abs(y) < 100) {
            sb.append("0");
        }
        if (abs(y) < 10) {
            sb.append("0");
        }
        sb.append(abs(y).toLong());
        return sb.toString();
    }

    /**
     * TODO Until TZ support implemented, the time is calculated in UTC+0 and TZ string is hardcoded
     */
    private timeZoneString(tzOffset: long): String {
        let sb = new StringBuilder();
        sb.append("GMT");
        let offset = -this.TZOffset;
        if (offset < 0) {
            sb.append("-");
        } else {
            sb.append("+")
        }
        let absOffset = abs(offset);
        let absHours = absOffset / 60;
        let absMinutes = absOffset % 60;
        if (absHours < 10) {
            sb.append("0");
        }
        sb.append(absHours);
        if (absMinutes < 10) {
            sb.append("0");
        }
        sb.append(absMinutes);
        return sb.toString();
    }
    /**
     * Returns a string representing the specified `Date` object interpreted in the local timezone.
     *
     * @returns { string } get new date value
     * @syscap SystemCapability.Utils.Lang
     * @FaAndStageModel
     */
    public override toString(): string {
        if (!this.isDateValid()) {
            return 'Invalid Date';
        }
        let tzOffset = this.TZOffset;
        let localTime = this.ms - tzOffset * 60 * msPerSecond;
        return this.dateString(localTime) + ' ' + this.timeString(localTime) + ' ' + this.timeZoneString(tzOffset);
    }

    /**
     * Returns a string representing the specified `Date` object interpreted in UTC.
     *
     * @returns { stirng } get new UTC date value
     * @throws { Error } - Input parameter error.
     * @syscap SystemCapability.Utils.Lang
     * @FaAndStageModel
     */
    public toUTCString(): string {
        if (!this.isDateValid()) {
            throw new Error("Invalid Date");
        }
        let s: String = this.toUTCDateString() + " " + this.toUTCTimeString();
        return s;
    }

    private toUTCDateString(): string {
        let sb = new StringBuilder();
        sb.append(dayNames[this.getUTCDay()]);
        sb.append(", ");
        let d = this.getUTCDate();
        if (d < 10) {
            sb.append("0");
        }
        sb.append(d);
        sb.append(" ");
        sb.append(monthNames[this.getUTCMonth()]);
        sb.append(" ");
        let y = this.getUTCFullYear();
        if (y < 0) {
            sb.append("-");
        }
        y = abs(y).toInt();
        if (y < 1000) {
            sb.append("0");
        }
        if (y < 100) {
            sb.append("0");
        }
        if (y < 10) {
            sb.append("0");
        }
        sb.append(y);
        return sb.toString();
    }

    private toUTCTimeString(): string {
        let sb = new StringBuilder();
        let h = this.getUTCHours();
        if (h < 10) {
            sb.append("0");
        }
        sb.append(h);
        sb.append(":");
        let m = this.getUTCMinutes();
        if (m < 10) {
            sb.append("0");
        }
        sb.append(m);
        sb.append(":");
        let s = this.getUTCSeconds();
        if (s < 10) {
            sb.append("0");
        }
        sb.append(s);
        sb.append(" GMT")
        return sb.toString();
    }
}

class ISODateParseResult {
    year: int = 0
    month: int = 1
    day: int = 1
    hour: int = 0
    minute: int = 0
    second: int = 0
    ms: int = 0
    tzOffset: long | undefined = undefined
    hasTime: boolean = false

    public override toString(): string {
        return `{ year: ${this.year}, month: ${this.month}, day: ${this.day}, hour: ${this.hour}, minute: ${this.minute}, second: ${this.second}, ms: ${this.ms}, TZ offset: ${this.tzOffset} }`
    }
}

const YEAR_COMPONENT_LENGTH: int = 4
const EXPANDED_YEAR_COMPONENT_LENGTH: int = 6
const MONTH_COMPONENT_LENGTH: int = 2
const DAY_COMPONENT_LENGTH: int = 2
const HOUR_COMPONENT_LENGTH: int = 2
const MINUTE_COMPONENT_LENGTH: int = 2
const SECOND_COMPONENT_LENGTH: int = 2
const MS_COMPONENT_LENGTH: int = 3

const DATE_TIME_SEPARATOR: string = "T"
const DATE_COMPONENTS_SEPARATOR: string = "-"
const TIME_COMPONENTS_SEPARATOR: string = ":"
const FRACTIONAL_SECONDS_SEPARATOR: string = "."

final class ISODateParseError extends Error { }

// https://tc39.es/ecma262/multipage/numbers-and-dates.html#sec-date-time-string-format
class ISODateParser {
    public static parse(dateStr: string): ISODateParseResult | undefined {
        const result = new ISODateParseResult()
        const a: ValueArray<char> = dateStr.getValueArrayChars()
        let pos: int = 0
        let end: int = a.length

        pos = ISODateParser.parseYearPart(a, pos, end, result)
        if (pos < 0) { return undefined }
        pos = ISODateParser.parseDatePart(a, pos, end, result)
        if (pos < 0) { return undefined }
        pos = ISODateParser.parseTimePart(a, pos, end, result)
        if (pos < 0) { return undefined }
        pos = ISODateParser.parseTimeZonePart(a, pos, end, result)
        if (pos < 0) { return undefined }

        return result
    }

    private static parseYearPart(a: ValueArray<char>, pos: int, end: int, result: ISODateParseResult): int {
        if (pos == end) { return -1 }
        if (a[pos] == c'+' || a[pos] == c'-') {
            let sign: int = a[pos] == c'-' ? -1 : 1
            pos++
            if (pos + EXPANDED_YEAR_COMPONENT_LENGTH > end) { return -1 }
            let yearVal: int = ISODateParser.parseNDigits(a, pos, EXPANDED_YEAR_COMPONENT_LENGTH)
            if (yearVal < 0) { return -1 }
            if (sign < 0 && yearVal == 0) {
                // -000000 is invalid per ECMA262 21.4.1.32.1; reject directly without Legacy fallback.
                if (pos + EXPANDED_YEAR_COMPONENT_LENGTH == end) {
                    throw new FormatError(`Invalid time value: '-000000'`)
                }
                return -1
            }
            result.year = sign * yearVal
            pos += EXPANDED_YEAR_COMPONENT_LENGTH
        } else {
            if (pos + YEAR_COMPONENT_LENGTH > end) { return -1 }
            result.year = ISODateParser.parseNDigits(a, pos, YEAR_COMPONENT_LENGTH)
            if (result.year < 0) { return -1 }
            pos += YEAR_COMPONENT_LENGTH
        }
        if (result.year > maxDateYears || result.year < -maxDateYears) {
            return -1
        }
        return pos
    }

    private static parseDatePart(a: ValueArray<char>, pos: int, end: int, result: ISODateParseResult): int {
        if (pos == end) { return pos }
        if (a[pos] != c'-' || pos + MONTH_COMPONENT_LENGTH + 1 > end) { return -1 }
        pos++
        result.month = ISODateParser.parseNDigits(a, pos, MONTH_COMPONENT_LENGTH)
        if (result.month < 1 || result.month > 12) {
            return -1
        }
        pos += MONTH_COMPONENT_LENGTH
        if (pos == end) { return pos }

        if (a[pos] != c'-' || pos + DAY_COMPONENT_LENGTH + 1 > end) { return -1 }
        pos++
        result.day = ISODateParser.parseNDigits(a, pos, DAY_COMPONENT_LENGTH)
        if (result.day < 1 || result.day > 31) {
            return -1
        }
        pos += DAY_COMPONENT_LENGTH
        return pos
    }

    private static parseTimePart(a: ValueArray<char>, pos: int, end: int, result: ISODateParseResult): int {
        if (pos == end) {
            result.tzOffset = 0
            return pos
        }
        if (a[pos] != c'T' || pos + HOUR_COMPONENT_LENGTH + 1 > end) { return -1 }
        pos++
        result.hasTime = true
        result.hour = ISODateParser.parseNDigits(a, pos, HOUR_COMPONENT_LENGTH)
        if (result.hour < 0 || result.hour > 24) { return -1 }
        pos += HOUR_COMPONENT_LENGTH

        if (pos >= end || a[pos] != c':' || pos + MINUTE_COMPONENT_LENGTH + 1 > end) { return -1 }
        pos++
        result.minute = ISODateParser.parseNDigits(a, pos, MINUTE_COMPONENT_LENGTH)
        if (result.minute < 0 || result.minute > 59) { return -1 }
        pos += MINUTE_COMPONENT_LENGTH

        if (pos < end && a[pos] == c':') {
            pos++
            if (pos + SECOND_COMPONENT_LENGTH > end) { return -1 }
            result.second = ISODateParser.parseNDigits(a, pos, SECOND_COMPONENT_LENGTH)
            if (result.second < 0 || result.second > 59) { return -1 }
            pos += SECOND_COMPONENT_LENGTH

            if (pos < end && a[pos] == c'.') {
                pos++
                let msStart: int = pos
                while (pos < end && a[pos] >= c'0' && a[pos] <= c'9') { pos++ }
                let msLen: int = pos - msStart
                if (msLen == 0) { return -1 }
                let msVal: int = 0
                // Truncate to MS_COMPONENT_LENGTH digits if more, zero-pad if less, for ISO 8601 compatibility.
                for (let i: int = 0; i < MS_COMPONENT_LENGTH; i++) {
                    msVal *= 10
                    if (i < msLen) {
                        msVal += a[msStart + i].toInt() - c'0'.toInt()
                    }
                }
                result.ms = msVal
            }
        }
        if (result.hour == 24 && (result.minute != 0 || result.second != 0 || result.ms != 0)) {
            return -1
        }
        return pos
    }

    private static parseTimeZonePart(a: ValueArray<char>, pos: int, end: int, result: ISODateParseResult): int {
        if (pos == end) {
            return pos
        }
        if (a[pos] == c'Z') {
            result.tzOffset = 0
            pos++
        } else if (a[pos] == c'+' || a[pos] == c'-') {
            let sign: int = a[pos] == c'-' ? 1 : -1
            pos++
            if (pos + HOUR_COMPONENT_LENGTH > end) { return -1 }
            let tzH: int = ISODateParser.parseNDigits(a, pos, HOUR_COMPONENT_LENGTH)
            if (tzH < 0 || tzH > 23) { return -1 }
            pos += HOUR_COMPONENT_LENGTH

            if (pos < end && a[pos] == c':') { pos++ }
            if (pos + MINUTE_COMPONENT_LENGTH > end) { return -1 }
            let tzM: int = ISODateParser.parseNDigits(a, pos, MINUTE_COMPONENT_LENGTH)
            if (tzM < 0 || tzM > 59) { return -1 }
            pos += MINUTE_COMPONENT_LENGTH
            result.tzOffset = sign * (tzH * msPerHour + tzM * msPerMinute)
        }
        if (pos != end) { return -1 }
        return pos
    }

    private static parseNDigits(a: ValueArray<char>, pos: int, n: int): int {
        let v: int = 0
        for (let i: int = 0; i < n; i++) {
            let ch: char = a[pos + i]
            if (ch < c'0' || ch > c'9') { return -1 }
            v = v * 10 + ch.toInt() - c'0'.toInt()
        }
        return v
    }
}

class LegacyDateParser {
    private static readonly TOK_END: int = 0;
    private static readonly TOK_NUMBER: int = 1;
    private static readonly TOK_SYMBOL: int = 2;
    private static readonly TOK_SPACE: int = 3;
    private static readonly TOK_TIMEZONE: int = 4;
    private static readonly TOK_MONTH: int = 5;
    private static readonly TOK_INVALID_WORD: int = 6;
    private static readonly TOK_UNKNOWN: int = 7;
    private static readonly MAX_DECIMAL: int = (Int.MAX_VALUE - 9) / 10;
    private static readonly WORD_TZ: int = 13;

    private chars: ValueArray<char>;
    private pos: int = 0;
    private end: int = 0;

    private raw0: int = 0;
    private raw1: int = 0;
    private raw2: int = 0;
    private rawIndex: int = 0;
    private monthWord: int = Int.MAX_VALUE;
    private timeHour: int = 0;
    private timeMinute: int = 0;
    private timeSecond: int = 0;
    private timeMs: int = 0;
    private timeIndex: int = 0;
    private tzSign: int = Int.MAX_VALUE;
    private tzHour: int = Int.MAX_VALUE;
    private tzMinute: int = Int.MAX_VALUE;

    private tokType: int = 0;
    private tokValue: int = 0;
    private tokLength: int = 0;
    private nextType: int = 0;
    private nextValue: int = 0;
    private nextLength: int = 0;

    public constructor(dateStr: string) {
        this.chars = dateStr.getValueArrayChars();
        this.end = dateStr.length;
    }

    public parseDate(): long {
        if (!this.tokenize()) {
            return INVALID_DATE;
        }
        return this.validateAndCompute();
    }

    private tokenize(): boolean {
        this.readToken();
        this.advance();

        let hasNumber: boolean = (this.rawIndex > 0);

        while (this.tokType != LegacyDateParser.TOK_END) {
            if (this.tokType == LegacyDateParser.TOK_NUMBER) {
                hasNumber = true;
                if (!this.parseNumber()) {
                    return false;
                }
            } else if (this.tokType == LegacyDateParser.TOK_MONTH) {
                this.monthWord = this.tokValue;
            } else if (this.tokType == LegacyDateParser.TOK_TIMEZONE && hasNumber) {
                this.tzSetUTC();
            } else if (this.tokType == LegacyDateParser.TOK_INVALID_WORD) {
                if (hasNumber) {
                    return false;
                }
                if (this.nextType == LegacyDateParser.TOK_NUMBER) {
                    return false;
                }
            } else if (this.isSign() && (this.timeIndex > 0 || this.tzIsUTC())) {
                if (!this.parseSign()) {
                    return false;
                }
            }
            this.advance();
        }
        return true;
    }

    private parseNumber(): boolean {
        const num: int = this.tokValue;
        if (this.nextIsSymbolChar(c':')) {
            this.advance();
            if (!this.nextIsNumber()) {
                return false;
            }
            if (!this.timeSetData(num)) {
                return false;
            }
        } else if (this.nextIsSymbolChar(c'.') && this.timeIsValidSecond(num)) {
            this.advance();
            this.timeSetData(num);
            if (!this.nextIsNumber()) {
                return false;
            }
            this.timeSetData(this.normMilliSecond(this.nextValue, this.nextLength));
            this.advance();
            if (!this.nextIsValidFinallyTime()) {
                return false;
            }
        } else if (this.timeIsValid(num)) {
            this.timeSetData(num);
            if (!this.nextIsValidFinallyTime()) {
                return false;
            }
        } else if (!this.rawSetData(num)) {
            return false;
        }
        return true;
    }

    private parseSign(): boolean {
        if (this.tokValue == c'-'.toInt()) {
            this.tzSign = -1;
        } else {
            this.tzSign = 1;
        }
        if (this.nextType != LegacyDateParser.TOK_NUMBER) {
            return false;
        }
        const timeNum: int = this.nextValue;
        const numLength: int = this.nextLength;
        this.advance();
        if (this.nextIsSymbolChar(c':')) {
            this.advance();
            if (!this.nextIsNumber()) {
                return false;
            }
            this.tzHour = timeNum;
            this.tzMinute = this.nextValue;
            this.advance();
        } else if (numLength == 1 || numLength == 2) {
            this.tzHour = timeNum;
            this.tzMinute = 0;
        } else if (numLength == 3 || numLength == 4) {
            this.tzHour = Math.floor(timeNum / 100).toInt();
            this.tzMinute = timeNum % 100;
        } else {
            return false;
        }
        return true;
    }

    private validateAndCompute(): long {
        let tzOffset: long = 0;
        let isLocal: boolean = false;
        if (!this.tzIsLocal()) {
            if (this.tzSign != Int.MAX_VALUE) {
                if (this.tzHour == Int.MAX_VALUE || this.tzHour < 0 || this.tzHour > 23) {
                    return INVALID_DATE;
                }
                if (this.tzMinute != Int.MAX_VALUE && (this.tzMinute < 0 || this.tzMinute > 59)) {
                    return INVALID_DATE;
                }
            }
            tzOffset = -(this.tzSign * (this.tzHour * secPerHour + this.tzMinute * secondsPerMinute)) * msPerSecond;
        } else {
            isLocal = true;
        }
        if (!this.validateTime()) {
            return INVALID_DATE;
        }
        if (!this.resolveYearMonthDay()) {
            return INVALID_DATE;
        }
        let year: int = this.raw0;
        let month: int = this.raw1;
        let day: int = this.raw2;
        if (year >= 0 && year <= 49) {
            year += 2000;
        } else if (year >= 50 && year <= 99) {
            year += 1900;
        }
        if (!(month >= 1 && month <= monthCountPerYear) || !(day >= 1 && day <= maxDaysInMonth)) {
            return INVALID_DATE;
        }
        if (year > maxDateYears || year < -maxDateYears) {
            return INVALID_DATE;
        }
        return this.computeTimestamp(year, month, day, tzOffset, isLocal);
    }

    private validateTime(): boolean {
        if (this.timeHour < 0 || this.timeHour > 24 ||
            this.timeMinute < 0 || this.timeMinute > 59 ||
            this.timeSecond < 0 || this.timeSecond > 59 ||
            this.timeMs < 0 || this.timeMs > 999) {
            return false;
        }
        if (this.timeHour == 24 && (this.timeMinute != 0 || this.timeSecond != 0 || this.timeMs != 0)) {
            return false;
        }
        return true;
    }

    private resolveYearMonthDay(): boolean {
        let d0: int = this.raw0;
        let d1: int = this.raw1;
        let d2: int = this.raw2;
        if (this.rawIndex == 0) {
            return false;
        }
        if (this.rawIndex == 1) {
            d1 = 1;
            d2 = 1;
        } else if (this.rawIndex == 2) {
            d2 = 1;
        }
        let isFull: boolean = (this.rawIndex == 3);
        if (this.monthWord == Int.MAX_VALUE) {
            if (isFull && !(d0 >= 1 && d0 <= monthCountPerYear)) {
                this.raw0 = d0;
                this.raw1 = d1;
                this.raw2 = d2;
            } else if (isFull) {
                this.raw0 = d2;
                this.raw1 = d0;
                this.raw2 = d1;
            } else {
                this.raw0 = d0;
                this.raw1 = d1;
                this.raw2 = d2;
            }
        } else {
            if (isFull) {
                return false;
            }
            this.raw1 = this.monthWord;
            if (this.rawIndex == 2) {
                if (!(d0 >= 1 && d0 <= maxDaysInMonth)) {
                    this.raw0 = d0;
                    this.raw2 = d1;
                } else {
                    this.raw0 = d1;
                    this.raw2 = d0;
                }
            } else {
                this.raw0 = 1;
                this.raw2 = d0;
            }
        }
        return true;
    }

    private computeTimestamp(year: int, month: int, day: int, tzOffset: long, isLocal: boolean): long {
        let dayMs: long = ecmaMakeDay(year.toLong(), (month - 1).toLong(), day.toLong());
        let timeMs: long = ecmaMakeTime(this.timeHour.toLong(), this.timeMinute.toLong(),
                                        this.timeSecond.toLong(), this.timeMs.toLong());
        let result: long = ecmaMakeDate(dayMs, timeMs);
        if (isLocal) {
            result += Date.getLocalTimezoneOffset(result) * msPerMinute;
        } else {
            result += tzOffset;
        }
        return result;
    }

    private peekChar(): char {
        return this.pos < this.end ? this.chars[this.pos] : c'\x7F';
    }

    private readToken(): void {
        const ch: char = this.peekChar();
        if (ch >= c'0' && ch <= c'9') {
            let num: int = 0;
            let len: int = 0;
            while (this.pos < this.end) {
                const c: char = this.chars[this.pos];
                if (c < c'0' || c > c'9') {
                    break;
                }
                if (num <= LegacyDateParser.MAX_DECIMAL) {
                    num = num * 10 + (c.toInt() - c'0'.toInt());
                }
                len++;
                this.pos++;
            }
            this.nextType = LegacyDateParser.TOK_NUMBER;
            this.nextValue = num;
            this.nextLength = len;
            return;
        }
        if (ch == c'\x7F') {
            this.nextType = LegacyDateParser.TOK_END;
            this.nextValue = 0;
            this.nextLength = 0;
            return;
        }
        if (ch == c':' || ch == c'+' || ch == c'-' || ch == c'.') {
            this.pos++;
            this.nextType = LegacyDateParser.TOK_SYMBOL;
            this.nextValue = ch.toInt();
            this.nextLength = 1;
            return;
        }
        if ((ch >= c'A' && ch <= c'Z') || (ch >= c'a' && ch <= c'z')) {
            this.readWord();
            return;
        }
        if (ch == c' ' || ch == c'\t' || ch == c'\n' || ch == c'\r') {
            this.pos++;
            this.nextType = LegacyDateParser.TOK_SPACE;
            this.nextValue = 0;
            this.nextLength = 1;
            return;
        }
        this.pos++;
        this.nextType = LegacyDateParser.TOK_UNKNOWN;
        this.nextValue = 0;
        this.nextLength = 1;
    }

    private readWord(): void {
        let c0: char = c'\x7F';
        let c1: char = c'\x7F';
        let c2: char = c'\x7F';
        let alphaLen: int = 0;
        while (this.pos < this.end) {
            const c: char = this.chars[this.pos];
            if ((c < c'A' || c > c'Z') && (c < c'a' || c > c'z')) {
                break;
            }
            let lc: char = Char.toLowerCase(c);
            if (alphaLen == 0) {
                c0 = lc;
            } else if (alphaLen == 1) {
                c1 = lc;
            } else if (alphaLen == 2) {
                c2 = lc;
            }
            alphaLen++;
            this.pos++;
        }
        let res: int = 0;
        let type: int = LegacyDateParser.TOK_INVALID_WORD;
        if (alphaLen >= 3) {
            const matched = this.matchWord(c0, c1, c2);
            if (matched == LegacyDateParser.WORD_TZ) {
                res = 1;
                type = LegacyDateParser.TOK_TIMEZONE;
            } else if (matched > 0) {
                res = matched;
                type = LegacyDateParser.TOK_MONTH;
            }
        } else if (alphaLen == 1 && c0 == c'z') {
            type = LegacyDateParser.TOK_TIMEZONE;
        }
        this.nextType = type;
        this.nextValue = res;
        this.nextLength = alphaLen;
    }

    private matchWord(c0: char, c1: char, c2: char): int {
        switch (c0) {
            case c'g':
                if (c1 == c'm' && c2 == c't') { return LegacyDateParser.WORD_TZ; }
                break;
            case c'u':
                if (c1 == c't' && c2 == c'c') { return LegacyDateParser.WORD_TZ; }
                break;
            case c'j':
                if (c1 == c'a' && c2 == c'n') { return 1; }
                if (c1 == c'u' && c2 == c'n') { return 6; }
                if (c1 == c'u' && c2 == c'l') { return 7; }
                break;
            case c'f':
                if (c1 == c'e' && c2 == c'b') { return 2; }
                break;
            case c'm':
                if (c1 == c'a' && c2 == c'r') { return 3; }
                if (c1 == c'a' && c2 == c'y') { return 5; }
                break;
            case c'a':
                if (c1 == c'p' && c2 == c'r') { return 4; }
                if (c1 == c'u' && c2 == c'g') { return 8; }
                break;
            case c's':
                if (c1 == c'e' && c2 == c'p') { return 9; }
                break;
            case c'o':
                if (c1 == c'c' && c2 == c't') { return 10; }
                break;
            case c'n':
                if (c1 == c'o' && c2 == c'v') { return 11; }
                break;
            case c'd':
                if (c1 == c'e' && c2 == c'c') { return 12; }
                break;
            default:
                break;
        }
        return 0;
    }

    private advance(): void {
        this.tokType = this.nextType;
        this.tokValue = this.nextValue;
        this.tokLength = this.nextLength;
        this.readToken();
    }

    private isSign(): boolean {
        return this.tokType == LegacyDateParser.TOK_SYMBOL &&
               (this.tokValue == c'+'.toInt() || this.tokValue == c'-'.toInt());
    }

    private nextIsSymbolChar(ch: char): boolean {
        return this.nextType == LegacyDateParser.TOK_SYMBOL && this.nextValue == ch.toInt();
    }

    private nextIsNumber(): boolean {
        return this.nextType == LegacyDateParser.TOK_NUMBER;
    }

    private nextIsValidFinallyTime(): boolean {
        return this.nextType == LegacyDateParser.TOK_END ||
               (this.nextType == LegacyDateParser.TOK_SYMBOL &&
               (this.nextValue == c'+'.toInt() || this.nextValue == c'-'.toInt())) ||
               (this.nextType == LegacyDateParser.TOK_TIMEZONE && this.nextValue == 0) ||
               this.nextType == LegacyDateParser.TOK_SPACE;
    }

    private rawSetData(d: int): boolean {
        if (this.rawIndex == 0) {
            this.raw0 = d;
            this.rawIndex = 1;
            return true;
        }
        if (this.rawIndex == 1) {
            this.raw1 = d;
            this.rawIndex = 2;
            return true;
        }
        if (this.rawIndex == 2) {
            this.raw2 = d;
            this.rawIndex = 3;
            return true;
        }
        return false;
    }

    private timeSetData(d: int): boolean {
        switch (this.timeIndex) {
            case 0:
                this.timeHour = d;
                this.timeIndex++;
                return true;
            case 1:
                this.timeMinute = d;
                this.timeIndex++;
                return true;
            case 2:
                this.timeSecond = d;
                this.timeIndex++;
                return true;
            case 3:
                this.timeMs = d;
                this.timeIndex++;
                return true;
            default:
                return false;
        }
    }

    private timeIsValid(n: int): boolean {
        return (this.timeIndex == 1 && n >= 0 && n <= 59) ||
               (this.timeIndex == 2 && n >= 0 && n <= 59);
    }

    private timeIsValidSecond(n: int): boolean {
        return this.timeIndex == 2 && n >= 0 && n <= 59;
    }

    private tzSetUTC(): void {
        this.tzSign = 1;
        this.tzHour = 0;
        this.tzMinute = 0;
    }

    private tzIsUTC(): boolean {
        return this.tzSign == 1 && this.tzHour == 0 && this.tzMinute == 0;
    }

    private tzIsLocal(): boolean {
        return this.tzHour == Int.MAX_VALUE;
    }

    private normMilliSecond(val: int, len: int): int {
        if (len == 3) {
            return val;
        }
        if (len == 2) {
            return val * 10;
        }
        if (len == 1) {
            return val * 100;
        }
        let divisor: int = 1;
        let rl: int = len;
        while (rl > 3) {
            divisor *= 10;
            rl--;
        }
        return Math.floor(val / divisor).toInt();
    }
}
