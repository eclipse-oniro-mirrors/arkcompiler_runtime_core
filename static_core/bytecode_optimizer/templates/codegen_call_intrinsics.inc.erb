% any_intrinsics = {
%   'ANY_LDBYIDX'          => 'AnyLdByIdx',
%   'ANY_STBYIDX'          => 'AnyStByIdx',
%   'ANY_LDBYVAL'          => 'AnyLdByVal',
%   'ANY_STBYVAL'          => 'AnyStByVal',
%   'ANY_CALL0'            => 'AnyCall0',
%   'ANY_CALL_RANGE'       => 'AnyCallRange',
%   'ANY_CALL_SHORT'       => 'AnyCallShort',
%   'ANY_CALL_THIS0'       => 'AnyCallThis0',
%   'ANY_CALL_THIS_RANGE'  => 'AnyCallThisRange',
%   'ANY_CALL_THIS_SHORT'  => 'AnyCallThisShort',
%   'ANY_CALL_NEW0'        => 'AnyCallNew0',
%   'ANY_CALL_NEW_RANGE'   => 'AnyCallNewRange',
%   'ANY_CALL_NEW_SHORT'   => 'AnyCallNewShort',
%   'ANY_ISINSTANCE'       => 'AnyIsinstance',
% }
% any_intrinsics.each do |enum_suffix, method|
    case compiler::RuntimeInterface::IntrinsicId::INTRINSIC_COMPILER_<%= enum_suffix %>: {
        BytecodeGen::Visit<%= method %>(visitor, inst);
        break;
    }
% end

% byname_intrinsics = {
%   'ANY_LDBYNAME' => 'AnyLdByName',
%   'ANY_STBYNAME' => 'AnyStByName',
% }
% byname_intrinsics.each do |enum_suffix, method|
    case compiler::RuntimeInterface::IntrinsicId::INTRINSIC_COMPILER_<%= enum_suffix %>: {
        if (!inst->GetFlag(compiler::inst_flags::ACC_WRITE) && !inst->GetFlag(compiler::inst_flags::ACC_READ)) {
            BytecodeGen::Visit<%= method %>V(visitor, inst);
            break;
        }

        BytecodeGen::Visit<%= method %>(visitor, inst);
        break;
    }
% end

% Runtime.intrinsics.select{ |i| i.static && !i.signature.stackrange && !i.is_stub && !i.compiler_only && i.has_impl? &&
%         !i.clear_flags.include?('call') }.each do |intrinsic|
    case compiler::RuntimeInterface::IntrinsicId::INTRINSIC_<%= intrinsic.enum_name %>: {
%       types = intrinsic.signature.args.map { |i| i.gsub("\\[", "[]") } + [intrinsic.signature.ret]
%       # `inspect` escapes possible backslashes in ret type descriptor
%       plugin_opts = Common::plugins[intrinsic.space.upcase]
%       sep = plugin_opts ? plugin_opts["class_name_separator"] : nil
%       class_name = intrinsic.class_name
%       signature = types.join(';')
%       if sep && sep != '.' then
%         class_name = class_name.gsub('.', sep)
%         signature = signature.gsub('.', sep)
%       end
        BytecodeGen::CallHandler(visitor, inst, <%= "#{class_name}.#{intrinsic.method_name}:#{signature};".inspect %>);
        break;
    }
% end