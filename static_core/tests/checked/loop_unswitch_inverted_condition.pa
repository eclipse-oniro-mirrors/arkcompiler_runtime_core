# Regression test for LoopUnswitch of a loop with two loop-invariant conditions
# on the same value with opposite condition codes (`jnez`/`jeqz` on the same flag,
# e.g. after Peepholes folds `IfImm NE (Compare EQ x, 0), 0` into `IfImm EQ x, 0`).
# LoopUnswitch must plant, in every loop copy, the constants that make each condition
# agree with the unswitch guard's polarity, derived from each condition's own CC/imm.

#! CHECKER      Inverted loop-invariant conditions are unswitched correctly (JIT)
#! RUN          force_jit: true, options: "--compiler-regex=.*compute.*", entry: "_GLOBAL::main", result: 0
#! EVENT        /Compilation,_GLOBAL::compute,.*COMPILED/
#! METHOD       "_GLOBAL::compute"
#! PASS_BEFORE  "LoopUnswitch"
#! # the loop contains the opposite conditions on the loop-invariant flag
#! INST_COUNT   /IfImm NE b\s+v0, 0x0/, 1
#! INST_COUNT   /IfImm EQ b\s+v0, 0x0/, 1
#! PASS_AFTER   "LoopUnswitch"
#! # both in-loop conditions are folded to constants, only the guard tests the flag
#! INST_COUNT   /IfImm (NE|EQ) b\s+v0, 0x0/, 1
#! # the guard and the folded conditions in both loop copies, plus loop-exit checks
#! TRUE         IR_COUNT(/IfImm (NE|EQ) b\s+v\d+, 0x0/) >= 5

#! CHECKER      Inverted loop-invariant conditions are unswitched correctly (AOT)
#! SKIP_IF      @architecture == "arm32"
#! RUN_PAOC     options: "--compiler-regex=.*compute.*"
#! METHOD       "_GLOBAL::compute"
#! PASS_AFTER   "LoopUnswitch"
#! # both in-loop conditions are folded to constants, only the guard tests the flag
#! INST_COUNT   /IfImm (NE|EQ) b\s+v0, 0x0/, 1
#! # the guard and the folded conditions in both loop copies, plus loop-exit checks
#! TRUE         IR_COUNT(/IfImm (NE|EQ) b\s+v\d+, 0x0/) >= 5
#! RUN          entry: "_GLOBAL::main", result: 0

.function i32 compute(u1 a0, i32 a1) {
    movi v0, 8
    movi v1, 20
    movi v3, 0
    mov v4, a1
loop:
    lda v4
    jlez loop_exit
    # flag ? 20 : 8, taken by `jnez`
    lda a0
    jnez take_b
    mov v5, v0
    jmp join1
take_b:
    mov v5, v1
join1:
    # flag ? 20 : 8, taken by `jeqz`
    lda a0
    jeqz take_a2
    mov v6, v1
    jmp join2
take_a2:
    mov v6, v0
join2:
    lda v5
    muli 100
    add2 v6
    sta v3
    lda v4
    subi 1
    sta v4
    jmp loop
loop_exit:
    lda v3
    return
}

.function i32 main() {
    # compute(false, 3) == 8 * 100 + 8 == 808
    movi v0, 0
    movi v1, 3
    call compute, v0, v1
    sta v2
    ldai 808
    jne v2, err_false
    # compute(true, 3) == 20 * 100 + 20 == 2020
    movi v0, 1
    movi v1, 3
    call compute, v0, v1
    sta v2
    ldai 2020
    jne v2, err_true
    ldai 0
    return
err_false:
    ldai 1
    return
err_true:
    ldai 2
    return
}
