# Check that the NEWOBJ TLAB fast path does not bypass the InstantiationError check for
# abstract classes: the class is initialized first, so only the fast-path guards stand
# between the newobj and the (wrongly allowed) allocation.

.record panda.InstantiationError <external>

.record R <abstract>
{
    i64 f
    i32 touched <static>
}

.function i32 main() {
    # Touch the class so it becomes INITIALIZED; otherwise the fast path would always
    # fall back to the slow path because of the uninitialized-class check.
    ldstatic R.touched
    sta v0
try_begin:
    newobj v0, R
    # Abstract class must not be instantiable.
    ldai 1
    return
try_end:

catch_block1_begin:
    ldai 0
    return

.catch panda.InstantiationError, try_begin, try_end, catch_block1_begin
}
