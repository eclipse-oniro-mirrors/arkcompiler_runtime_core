.record IO <external>
.function void IO.printString(panda.String a0) <external>
.record panda.String <external>

.record Base {}

.function void Base.bar(Base a0, i32 a1) {
	lda.str "INSTANCE\n"
	sta.obj v0
	call.short IO.printString, v0
	return.void
}

.record Foo <extends=Base> {}

.function void Foo.bar(i32 a0) <static> {
	lda.str "STATIC\n"
	sta.obj v0
	call.short IO.printString, v0
	return.void
}
