#ifndef LIBPANDAFILE_FILE_FORMAT_VERSION_H
#define LIBPANDAFILE_FILE_FORMAT_VERSION_H

#include <array>
#include <string>
#include <sstream>
#include <iomanip>
#include <iterator>
#include <map>
#include <optional>
#include <set>

#include "file.h"
#include "utils/const_value.h"

namespace panda::panda_file {
constexpr uint8_t API_12 = 12;
const std::string SUB_API_VERSION_1 = "beta1";
const std::string SUB_API_VERSION_2 = "beta2";
const std::string DEFAULT_SUB_API_VERSION = SUB_API_VERSION_1;

constexpr std::array<uint8_t, File::VERSION_SIZE> version {<%= Panda::version.split('.').join(', ') %>};
constexpr std::array<uint8_t, File::VERSION_SIZE> minVersion {<%= Panda::min_version.split('.').join(', ') %>};
const std::set<std::array<uint8_t, File::VERSION_SIZE>> incompatibleVersion {
% Panda::incompatible_version.each do |api_version|
    {<%= api_version.split('.').join(', ') %>},
% end
};

std::string GetVersion(const std::array<uint8_t, File::VERSION_SIZE> &version);

PANDA_PUBLIC_API bool IsVersionLessOrEqual(const std::array<uint8_t, File::VERSION_SIZE> &currrent_version,
                                           const std::array<uint8_t, File::VERSION_SIZE> &target_version);

inline void PrintBytecodeVersion()
{
    std::stringstream ss;

    ss << "Bytecode version " << GetVersion(version) << '\n';
    ss << "Minimum supported bytecode version " << GetVersion(minVersion) << '\n';

    std::cout << ss.str() << std::endl;
}

// A dotted api version (major.minor.patch); an integer key N in isa.yaml means N.0.0.
using ApiVersion = std::array<uint8_t, 3>;

inline std::string GetApiVersionString(const ApiVersion &api)
{
    std::stringstream ss;
    ss << static_cast<uint32_t>(api[0]) << "." << static_cast<uint32_t>(api[1]) << "."
       << static_cast<uint32_t>(api[2]);
    return ss.str();
}

// Keys must be kept in sync with isa.yaml. Do not add derived entries here:
// the map is generated from the explicit api_version_map list only, so that
// e.g. 26 / 26.0.0 can stay on an older bytecode version than 'version'.
const std::map<ApiVersion, std::array<uint8_t, File::VERSION_SIZE>> api_version_map {
% Panda::api_version_map.each do |api_version|
%   api_parts = api_version[0].to_s.split('.')
%   while api_parts.size < 3
%     api_parts.push('0')
%   end
    {ApiVersion {<%= api_parts.join(', ') %>}, {<%= api_version[1].split('.').join(', ') %>}},
% end
};

inline void PrintSupportedApi() {
    static constexpr size_t WIDTH = 20;  // set output width
    std::cout << "Supported apis and corresponding file versions:" << std::endl;
    std::cout << std::setw(WIDTH) << "api" << std::setw(WIDTH) << "file version" << std::endl;
    for (const auto &[legal_api, file_version] : api_version_map) {
        if (legal_api == ApiVersion {0, 0, 0}) {
            continue;
        }
        std::cout << std::setw(WIDTH) << GetApiVersionString(legal_api);
        std::cout << std::setw(WIDTH) << GetVersion(file_version) << std::endl;
    }
}

// Resolution result for a target api version.
struct ApiVersionResolution {
    std::array<uint8_t, File::VERSION_SIZE> version;
    // true when the requested api version is an exact key of api_version_map
    // (the historical API12 + beta1/beta2 case counts as exact as well)
    bool exact;
};

inline ApiVersionResolution ResolveVersionByApi(uint8_t major, uint8_t minor, uint8_t patch,
                                                const std::string &subApi)
{
    if (major == API_12 && minor == 0 && patch == 0 &&
        (subApi == SUB_API_VERSION_1 || subApi == SUB_API_VERSION_2)) {
        return {std::array<uint8_t, File::VERSION_SIZE> {12, 0, 2, 0}, true};
    }

    const ApiVersion key {major, minor, patch};
    const auto iter = api_version_map.find(key);
    if (iter != api_version_map.end()) {
        return {iter->second, true};
    }

    // The requested version is not a known one:
    //  - above the newest known version, or below the oldest one: keep the legacy
    //    behaviour and resolve to the current (latest) version;
    //  - between two known versions: fall back to the nearest lower known version.
    const auto upper = api_version_map.upper_bound(key);
    if (upper == api_version_map.begin() || upper == api_version_map.end()) {
        return {version, false};
    }
    return {std::prev(upper)->second, false};
}

inline std::optional<const std::array<uint8_t, File::VERSION_SIZE>> GetVersionByApi(uint8_t major,
    uint8_t minor, uint8_t patch, const std::string &subApi)
{
    return ResolveVersionByApi(major, minor, patch, subApi).version;
}

// Legacy single-component entry point: an integer api level N means N.0.0.
inline std::optional<const std::array<uint8_t, File::VERSION_SIZE>> GetVersionByApi(uint8_t api,
                                                                                    std::string subApi)
{
    return GetVersionByApi(api, 0, 0, subApi);
}

}  // namespace panda::panda_file

#endif
