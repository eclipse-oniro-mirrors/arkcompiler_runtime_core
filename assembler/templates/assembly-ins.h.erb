template <typename... Args>
Ins *Ins::CreateIns(Opcode opcode, Args &&... args)
{
    return Ins::CreateInsImpl(opcode, std::forward<Args>(args)...);
}

// For each opcode, select the narrowest (mnemonic, format) subclass whose
// encoding widths accommodate the supplied operand values. This keeps the
// in-memory representation as small as possible while never truncating --
// values that overflow the narrow formats fall through to the widest format,
// matching the emitter's own smallest-fitting selection.
inline Ins *Ins::CreateInsImpl(Opcode opcode, const std::vector<std::uint16_t> &regs, const std::vector<IType> &imms,
                               const std::vector<std::string> &ids)
{
    std::vector<const std::string*> interned;
    interned.reserve(ids.size());
    for (const auto &id : ids) {
        interned.push_back(Ins::Intern(id));
    }
    switch(opcode) {
% Panda::instructions.group_by(&:mnemonic).each do |mnemonic, group|
%   if group.first.jump?
%     insn = group.min_by { |i| i.format.size }
%     # A single subclass serves the whole mnemonic, so every register operand must
%     # share one storage width across all jump formats. Fail at generation time if
%     # a future ISA adds a jump variant with a wider register operand, otherwise
%     # the narrow member below would silently truncate it.
%     reg_widths = group.flat_map { |i| i.operands.select(&:reg?).map(&:width) }.uniq
%     raise "jump '#{mnemonic}' has mixed register widths #{reg_widths}" if reg_widths.size > 1
%     class_name = insn_class_name(insn)
        case Opcode::<%= insn.asm_token %>: {
            return new <%= class_name %>(regs, imms, interned);
        }
%   else
%     sorted = group.sort_by { |i| i.format.size }
        case Opcode::<%= group.first.asm_token %>: {
%     sorted[0..-2].each do |i|
%       cond = format_fit_condition(i)
            if (<%= cond %>) {
                return new <%= insn_class_name(i) %>(regs, imms, interned);
            }
%     end
            return new <%= insn_class_name(sorted[-1]) %>(regs, imms, interned);
        }
%   end
% end
        default:
            UNREACHABLE();
    }
}

