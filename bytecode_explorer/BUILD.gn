import("//arkcompiler/runtime_core/ark_config.gni")
import("$ark_root/tests/test_helper.gni")

config("bytecode_explorer_public_config") {
  include_dirs = [ "." ]
  if (is_mingw) {
    # The bundled MinGW libc++ supplies PMR through its experimental library.
    libs = [ "c++experimental" ]
  }
}

